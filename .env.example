# Copy to .env and fill in locally. Never commit .env.
# Names only — values are provided per machine.

# Seat runtime (Claude Code seats)
ANTHROPIC_API_KEY=

# Optional Featherless-backed seat (e.g. the Breaker) — see BLUEPRINT step 5
FEATHERLESS_API_KEY=

# Cognito public app configuration. Never add a client secret to VITE_ variables.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=
VITE_COGNITO_ISSUER=
# Optional. Defaults to "openid email". Only widen this (e.g. "openid email profile phone address")
# after allowing those scopes on the app client, or /oauth2/authorize rejects the request.
VITE_COGNITO_SCOPES=
