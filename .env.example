# Copy to .env and fill in locally. Never commit .env.
# Names only — values are provided per machine.

# Seat runtime (Claude Code seats)
ANTHROPIC_API_KEY=

# Optional Featherless-backed seat (e.g. the Breaker) — see BLUEPRINT step 5
FEATHERLESS_API_KEY=

# Render server-only Cognito Hosted UI configuration. Never put these in VITE_ variables.
COGNITO_DOMAIN=https://<domain>.auth.<region>.amazoncognito.com
COGNITO_CLIENT_ID=<confidential-app-client-id>
COGNITO_CLIENT_SECRET=<Render-secret>
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_REDIRECT_URI=https://<render-host>/auth/callback
COGNITO_LOGOUT_URI=https://<render-host>/Nexus/auth.html
SESSION_SECRET=<long-random-Render-secret>
PORT=8080
